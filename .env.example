# Vanna Configuration

# -- LLM --
# Choose your LLM: openai, bedrock, ollama, or google
LLM=ollama

# -- OpenAI --
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4

# -- AWS Bedrock --
# BEDROCK_MODEL=anthropic.claude-v2

# -- Ollama --
OLLAMA_MODEL=phi3

# -- Google --
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-pro

# -- Vector Store --
# Choose your vector store: chromadb
VECTOR_STORE=chromadb

# -- ChromaDB --
CHROMA_PATH=./chroma

# -- Database --
# Choose your database: sqlite, mysql, or postgresql
DATABASE=sqlite

# -- SQLite --
SQLITE_PATH=my-database.sqlite

# -- MySQL --
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# -- PostgreSQL --
# POSTGRES_HOST=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=

# -- Security & Performance --
# Rate limiting (requests per time window)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW=60

# Request timeout (seconds)
REQUEST_TIMEOUT=30
